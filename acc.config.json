{
  "standardVersion": "0.1.0",
  "project": {
    "name": "MissionPilot",
    "slug": "missionpilot",
    "description": "",
    "language": "fr"
  },
  "profiles": [
    "base"
  ],
  "adapters": [
    "claude"
  ],
  "stack": {
    "packageManager": "pnpm",
    "workspaces": true,
    "typescript": true,
    "eslint": true,
    "prettier": true,
    "languages": [
      "typescript"
    ]
  },
  "commands": {
    "install": "pnpm install",
    "dev": "pnpm dev",
    "build": "pnpm build",
    "typecheck": "pnpm typecheck",
    "lint": "pnpm lint",
    "test": "pnpm test"
  },
  "ports": {
    "api": 4100,
    "web": 3100,
    "postgres": 55440
  },
  "git": {
    "mainBranch": "main",
    "protectedBranches": [
      "main",
      "master"
    ]
  },
  "hooks": {
    "preCommit": [
      "pnpm typecheck",
      "pnpm lint"
    ]
  },
  "guard": {
    "protectedPaths": [],
    "destructiveCommands": [
      {
        "pattern": "\\bDROP\\s+DATABASE\\b",
        "reason": "Suppression de base de données interdite aux agents."
      }
    ]
  },
  "options": {
    "agentBus": true,
    "demoInstance": false
  },
  "demo": {}
}
