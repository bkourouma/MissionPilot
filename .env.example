# Copier vers .env (jamais commité). Valeurs de développement uniquement.
# Rôle propriétaire : migrations seulement. Rôle applicatif : sans BYPASSRLS, non propriétaire.
DATABASE_OWNER_URL=postgres://missionpilot_owner:dev_only_owner_password@127.0.0.1:55440/missionpilot
DATABASE_URL=postgres://missionpilot_app:dev_only_app_password@127.0.0.1:55440/missionpilot
API_PORT=4100
WEB_PORT=3100
WEB_ORIGIN=http://localhost:3100
API_URL=http://localhost:4100
# NODE_ENV absent, development ou test : valeurs de développement admises
# UNIQUEMENT avec une base locale (localhost, 127.0.0.1, ::1). Serveur : production.
# Secret de signature de session, 32 caractères minimum.
SESSION_SECRET=dev-only-change-me-dev-only-change-me
# Secret maître du chiffrement des secrets 2FA, codes de secours et e-mails en
# file : 32 caractères minimum, DISTINCT de SESSION_SECRET.
TFA_MASTER_KEY=dev-only-tfa-master-key-change-me-0000
# Rotation : l'ancienne TFA_MASTER_KEY, le temps que les chiffrés soient repris
# (facultatif). Les chiffrés antérieurs à TFA_MASTER_KEY (dérivés de
# SESSION_SECRET) restent lisibles tant que SESSION_SECRET ne change pas.
TFA_MASTER_KEY_PRECEDENTE=
# OpenRouter (V2). Sans clé : gabarits déterministes. Clé de PLATEFORME, de
# repli : un cabinet peut enregistrer sa propre clé (chiffrée en base).
OPENROUTER_API_KEY=
# Point d'accès (HTTPS ; HTTP seulement vers la machine locale) et délai d'un
# appel au modèle en millisecondes (1000 à 300000).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
IA_TIMEOUT_MS=60000
IA_PLAFOND_PLATEFORME_MICRO_USD=50000000

# E-mail (SMTP) : obligatoire hors développement et test (l'API refuse de démarrer sans).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=starttls
MAIL_FROM=
# Double authentification : "oui" l'impose aux rôles sensibles de tous les cabinets.
TOTP_REQUIS=
# Connexion rapide de démonstration (recette humaine locale) : la page de connexion
# liste les comptes du cabinet « Lagune Conseil & Associés (démo) » (db:seed-demo) et
# ouvre leur session SANS mot de passe (jamais un compte à 2FA active ou obligatoire).
# Désactivée par défaut ("non"). "oui" fait REFUSER le démarrage hors développement
# local (NODE_ENV development ou test ET bases sur localhost, 127.0.0.1 ou ::1).
# CONNEXION_RAPIDE_DEMO=oui

# Stockage des fichiers téléversés (documents de mission, justificatifs).
# STORAGE_DRIVER : "disque" (seul disponible ; "s3" : point d'extension non implémenté).
STORAGE_DRIVER=disque
# Dossier ABSOLU, hors du dépôt, jamais servi en statique. Obligatoire hors
# développement ; vide en développement : ~/.missionpilot/stockage.
STORAGE_DIR=
# Plafond par fichier (octets ; défaut 15 Mo) et quota par cabinet (défaut 2 Go).
FICHIER_TAILLE_MAX_OCTETS=15728640
QUOTA_STOCKAGE_CABINET_OCTETS=2147483648
# CHROMIUM_PATH=/usr/bin/chromium  (rapports PDF, chemin absolu facultatif ; sans lui : Chrome installé en développement Windows, sinon PDF indisponible)
